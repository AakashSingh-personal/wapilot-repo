PORT=3000
DATABASE_URL=postgresql://user:pass@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
# Optional: direct (non-pooler) URL for Prisma CLI migrations on Neon
# DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
# If you see "connection pool" timeouts: avoid connection_limit=1 on a long-running API unless you use
# PgBouncer transaction mode (pgbouncer=true). Optional override when the app rewrites limit=1:
# DATABASE_CONNECTION_LIMIT=10
# PRISMA_POOL_TIMEOUT=30
JWT_SECRET=supersecret

WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=

# AI replies (WhatsApp bot). Groq uses the OpenAI-compatible API.
# If AI_PROVIDER is unset: only Groq key → Groq; only OpenAI key → OpenAI; both → OpenAI (set AI_PROVIDER=groq to prefer Groq).
# AI_PROVIDER=groq|openai
AI_PROVIDER=

GROQ_API_KEY=
# Groq model IDs change over time — see https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Platform UPI for SaaS subscription billing (receive subscription payments)
WAPILOT_PLATFORM_UPI_ID=yourname@paytm
# SUBSCRIPTION_PRO_AMOUNT=999
# Default: Razorpay Payment Link (avoids saved-card "Invalid Token" in Checkout).
# Set SUBSCRIPTION_USE_CHECKOUT=1 to use embedded Checkout.js instead.
# SUBSCRIPTION_USE_CHECKOUT=0

# Optional: comma-separated origins for browser clients (defaults include localhost:5173)
# CORS_ORIGIN=http://localhost:5173

# REDIS_URL must be a bare connection URI (do not paste `redis-cli -u …`):
# REDIS_URL=redis://default:YOUR_PASSWORD@redis-xxxxx.region.provider.com:10990
# Optional fallbacks if Settings → client profile fields are empty (templates / variables)
# BUSINESS_DISPLAY_PHONE=+919999999999
# SUPPORT_PHONE=+918888888888
# Optional channel override (default: wapilot:realtime)
# REDIS_REALTIME_CHANNEL=wapilot:realtime

# Razorpay (customer payments, appointment advance links, SaaS billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Default advance % when booking with collectAdvance (integer 1–100)
APPOINTMENT_ADVANCE_PERCENT=30

# Google Calendar OAuth (staff scheduling sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Public API base URL (OAuth redirect fallback if GOOGLE_CALENDAR_REDIRECT_URI unset)
API_PUBLIC_URL=http://localhost:3000
# Encrypt stored calendar tokens (falls back to JWT_SECRET)
CALENDAR_TOKEN_SECRET=
# Poll external calendars for busy blocks (ms, default 15 min)
CALENDAR_SYNC_MS=900000

# Microsoft Outlook / Azure AD calendar OAuth
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=
# Webhook validation secret (optional; falls back to CALENDAR_TOKEN_SECRET)
OUTLOOK_WEBHOOK_SECRET=
# Graph subscription lifetime in minutes (max ~4230, default 4200)
OUTLOOK_SUBSCRIPTION_MINUTES=4200
# Aliases: AZURE_CLIENT_ID, AZURE_CLIENT_SECRET

# Appointment reminders — comma-separated channels (WHATSAPP,EMAIL,SMS)
REMINDER_CHANNELS=WHATSAPP
REMINDER_POLL_MS=60000

# SMTP (email reminders and booking confirmations). Requires customer.email on the customer record.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Twilio (SMS reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp template names for scheduling (used outside 24h session window).
# Per-business overrides: Scheduling → Notifications tab (stored in businessConfig.schedulingSettings).
# Env vars below are optional platform-wide fallbacks when a business has not configured its own templates.
# Template body should have 4 variables for reminder: {{1}} service, {{2}} when, {{3}} ref, {{4}} staff/label
# WHATSAPP_REMINDER_TEMPLATE=
# WHATSAPP_CONFIRMATION_TEMPLATE=
# WHATSAPP_REBOOKING_TEMPLATE=
# WHATSAPP_SCHEDULING_TEMPLATE_LANG=en_US

# Apple iCloud CalDAV (staff connect via app-specific password in UI)
APPLE_CALDAV_URL=https://caldav.icloud.com

# Redis slot lock TTL during booking (seconds, default 30)
SLOT_LOCK_TTL_SEC=30

# AI rebooking campaign worker interval (ms, default 24h). Set REBOOKING_CAMPAIGN_MS=0 to disable.
REBOOKING_CAMPAIGN_MS=86400000

# LLM tool-calling for WhatsApp scheduling (requires GROQ_API_KEY or OPENAI_API_KEY). Set to 0 to disable.
AI_SCHEDULING_TOOLS=1

# ── Phase 5 enterprise hardening ──

# S3 staff profile photos (presigned PUT). Falls back to Supabase when unset.
# AWS_S3_BUCKET=
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_PUBLIC_BASE_URL=
# AWS_PRESIGN_TTL_SEC=300
# STAFF_PHOTO_BUCKET=wapilot-media

# Public booking rate limits (in-memory per instance)
# PUBLIC_BOOKING_RATE_WINDOW_MS=60000
# PUBLIC_BOOKING_RATE_MAX=30
# PUBLIC_APPOINTMENT_RATE_WINDOW_MS=60000
# PUBLIC_APPOINTMENT_RATE_MAX=40

# PostgreSQL row-level security (defense in depth; opt-in)
# SCHEDULING_RLS_ENABLED=1

# RabbitMQ (optional). Exchange + queues auto-create on connect. Omit RABBITMQ_URL to use in-process poll workers.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# RABBITMQ_EXCHANGE=wapilot.scheduling
# SCHEDULING_USE_RABBITMQ=0

# Worker deployment: WORKER_ENABLE=true (default) runs workers in the same process as the API.
# WORKER_ENABLE=false skips workers on API — deploy separately with `npm run worker`.
# WORKER_ENABLE=true

# Apple CalDAV has no webhooks — use faster poll when needed (ms)
# APPLE_CALENDAR_SYNC_MS=300000
# WAITLIST_POLL_MS=300000
# IDEMPOTENCY_PURGE_MS=86400000
