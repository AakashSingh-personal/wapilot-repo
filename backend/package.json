{
  "name": "wapilot-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "node --test tests/**/*.test.js",
    "test:scheduling": "node --test tests/scheduling/**/*.test.js",
    "test:scheduling:load": "node --test tests/scheduling/load-concurrent-bookings.test.js",
    "worker": "node src/worker.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.812.0",
    "@aws-sdk/s3-request-presigner": "^3.812.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.105.3",
    "amqplib": "^0.10.8",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "form-data": "^4.0.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.2",
    "openai": "^5.23.2",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "rrule": "^2.8.1",
    "tsdav": "^2.2.2",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  },
  "allowScripts": {
    "prisma@7.8.0": true,
    "@prisma/engines@7.8.0": true
  }
}
