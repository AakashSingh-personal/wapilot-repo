generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
  CHIEF_ADMIN
}

enum LeadStatus {
  NEW
  BOOKED
  CLOSED
}

enum MessageType {
  USER
  BOT
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SubscriptionPlan {
  BASIC
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

enum PaymentType {
  SUBSCRIPTION
  WALLET_TOPUP
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CustomerPaymentStatus {
  PENDING
  PAID
}

enum TemplateStatus {
  WORKING
  NOT_WORKING
}

enum CampaignStatus {
  COMPLETED
  PARTIAL
  FAILED
}

enum VariableDefinitionType {
  BUSINESS
  CUSTOMER
}

enum WalletTxnType {
  CREDIT
  DEBIT
}

enum AiResumeMode {
  NEW_MESSAGES_ONLY
  LAST_CUSTOMER_MESSAGE
}

model Business {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  ownerId         String?  @db.Uuid
  phoneNumberId   String?  @unique
  createdAt       DateTime @default(now())

  users            User[]
  customers        Customer[]
  leads            Lead[]
  messages         Message[]
  bookings         Booking[]
  config           BusinessConfig?
  subscriptions    Subscription[]
  payments         Payment[]
  customerPayments CustomerPayment[]
  contacts         Contact[]
  templates        Template[]
  campaigns        CommunicationCampaign[]
  wallet           Wallet?
  walletTxns       WalletTransaction[]
  variableDefinitions VariableDefinition[]
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  password   String
  businessId String   @db.Uuid
  role       UserRole @default(STAFF)
  createdAt  DateTime @default(now())

  business              Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  aiPausedConversations Customer[] @relation("CustomerAiOverrideBy")

  @@index([businessId])
}

model Customer {
  id                           String    @id @default(uuid()) @db.Uuid
  phone                        String
  name                         String?
  businessId                   String    @db.Uuid
  bookingSlotSelectionPending  Boolean   @default(false)
  /** Last inbound message from the customer (USER). Drives 24h session + reopen. */
  lastInboundCustomerMessageAt DateTime?
  /** Increments on each inbound USER message; cleared when staff opens the thread. */
  inboxUnreadCount             Int       @default(0)
  aiEnabled                    Boolean        @default(true)
  aiOverride                   Boolean        @default(false)
  aiOverrideByUserId           String?        @db.Uuid
  aiOverrideAt                 DateTime?
  aiResumeMode                 AiResumeMode?
  createdAt                    DateTime       @default(now())

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  aiOverrideBy   User?    @relation("CustomerAiOverrideBy", fields: [aiOverrideByUserId], references: [id], onDelete: SetNull)
  leads    Lead[]
  messages Message[]
  bookings Booking[]
  payments CustomerPayment[]
  variableValues CustomerVariableValue[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model Lead {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @db.Uuid
  businessId String     @db.Uuid
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Message {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @db.Uuid
  businessId String      @db.Uuid
  content    String
  type       MessageType
  createdAt  DateTime    @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerId])
}

model Booking {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @db.Uuid
  businessId String        @db.Uuid
  service    String
  slot       String
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessConfig {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @unique @db.Uuid
  services          Json     @default("[]")
  workingHours      String   @default("{}")
  autoReplyEnabled  Boolean  @default(true)
  upiId             String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  businessId String             @db.Uuid
  plan       SubscriptionPlan
  status     SubscriptionStatus @default(ACTIVE)
  amount     Decimal            @db.Decimal(12, 2)
  createdAt  DateTime           @default(now())
  expiresAt  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  businessId String        @db.Uuid
  amount     Decimal       @db.Decimal(12, 2)
  type       PaymentType
  status     PaymentStatus @default(PENDING)
  providerOrderId String?
  providerPaymentId String?
  providerSignature String?
  provider          String?
  createdAt  DateTime      @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model CustomerPayment {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String                @db.Uuid
  customerId String                @db.Uuid
  amount     Decimal               @db.Decimal(12, 2)
  status     CustomerPaymentStatus @default(PENDING)
  providerLinkId String?
  providerPaymentId String?
  provider     String?
  createdAt  DateTime              @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  phone      String
  name       String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phone])
  @@index([businessId])
}

model Template {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @db.Uuid
  name            String
  content         String
  status          TemplateStatus @default(WORKING)
  /** Meta message template id (for updates). Backfilled from list sync when missing. */
  metaTemplateId  String?
  /** Last Meta-oriented payload (components, category, language) for edit/clone round-trip. */
  metaSnapshot    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns CommunicationCampaign[]
  variableMappings TemplateVariableMapping[]

  @@index([businessId])
}

model VariableDefinition {
  id             String                 @id @default(uuid()) @db.Uuid
  businessId     String                 @db.Uuid
  key            String
  label          String
  type           VariableDefinitionType
  description    String                 @default("")
  defaultValue   String                 @default("")
  isEditable     Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  business       Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerValues CustomerVariableValue[]

  @@unique([businessId, key])
  @@index([businessId])
}

model CustomerVariableValue {
  id                   String             @id @default(uuid()) @db.Uuid
  customerId           String             @db.Uuid
  variableDefinitionId String             @db.Uuid
  value                String             @default("")

  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  definition VariableDefinition @relation(fields: [variableDefinitionId], references: [id], onDelete: Cascade)

  @@unique([customerId, variableDefinitionId])
  @@index([variableDefinitionId])
}

model TemplateVariableMapping {
  id               String   @id @default(uuid()) @db.Uuid
  templateId       String   @db.Uuid
  placeholderIndex Int
  variableKey      String

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, placeholderIndex])
  @@index([templateId])
}

model CommunicationCampaign {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @db.Uuid
  templateId      String         @db.Uuid
  status          CampaignStatus
  totalContacts   Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  totalCharged    Decimal        @db.Decimal(12, 2)
  messageCost     Decimal        @db.Decimal(12, 2)
  createdAt       DateTime       @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  walletTxns WalletTransaction[]

  @@index([businessId])
}

model Wallet {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @unique @db.Uuid
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id          String        @id @default(uuid()) @db.Uuid
  businessId  String        @db.Uuid
  campaignId  String?       @db.Uuid
  contactId   String?       @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  type        WalletTxnType
  description String?
  createdAt   DateTime      @default(now())

  business Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign CommunicationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([campaignId])
}
