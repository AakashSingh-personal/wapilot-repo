# Leave empty to use Vite dev proxy to localhost:3000 (WebSocket will use this page origin).
# For production (e.g. Cloudflare Pages + API on Render), set this at BUILD time:
# VITE_API_URL=https://vartalap-repo.onrender.com
# VITE_API_URL=http://localhost:3000
#
# Cloudflare Pages: Settings → Environment variables → Production → VITE_API_URL
# Build command: npm run build   Root directory: frontend
